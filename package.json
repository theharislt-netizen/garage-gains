{
  "name": "rigcore",
  "version": "3.3.2",
  "private": true,
  "description": "RIGCORE — garage gym tracker wrapped as a native Android app",
  "scripts": {
    "test:backup": "node scripts/test-backup-restore.mjs",
    "prepare:www": "node scripts/prepare-www.mjs",
    "bundle:live": "node scripts/make-live-bundle.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "sync": "npm run prepare:www && npx cap sync android",
    "build:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.28.2"
  }
}
