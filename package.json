{
  "name": "rigcore",
  "version": "3.4.14",
  "private": true,
  "description": "RIGCORE — garage gym tracker for Android and iPhone",
  "scripts": {
    "test:backup": "node scripts/test-backup-restore.mjs",
    "test:economy": "node scripts/test-testing-economy.mjs",
    "test:rank": "node scripts/test-rank-rewards.mjs",
    "test:onboard": "node scripts/test-first-run-unlock.mjs",
    "test:morning": "node scripts/test-morning-stretch.mjs",
    "test:quicklog": "node scripts/test-quicklog.mjs",
    "test:dash": "node scripts/test-dash-collapse.mjs",
    "test:settings": "node scripts/test-settings-rework.mjs",
    "test:v42": "node scripts/test-v42.mjs",
    "test:v43": "node scripts/test-v43.mjs",
    "test:v44": "node scripts/test-v44.mjs",
    "test:v45": "node scripts/test-v45.mjs",
    "test:v47": "node scripts/test-v47.mjs",
    "test:v48": "node scripts/test-v48.mjs",
    "test:v49": "node scripts/test-v49.mjs",
    "test:v50": "node scripts/test-v50.mjs",
    "test:v51": "node scripts/test-v51.mjs",
    "test:v52": "node scripts/test-v52.mjs",
    "test:v53": "node scripts/test-v53.mjs",
    "test:v54": "node scripts/test-v54.mjs",
    "test:ui-smooth": "node scripts/test-ui-smooth.mjs",
    "test:box-reveal": "node scripts/test-box-reveal.mjs",
    "test:ios": "node scripts/verify-ios-project.mjs",
    "test:layout": "node scripts/test-safe-area.mjs",
    "verify:update": "node scripts/verify-live-update.mjs",
    "prepare:www": "node scripts/prepare-www.mjs",
    "bundle:live": "node scripts/make-live-bundle.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "sync": "npm run prepare:www && npx cap sync android ios",
    "build:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "build:ios": "bash scripts/build-ios.sh",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "esbuild": "^0.28.2"
  }
}
