{
  "appId": "com.palace.app",
  "appName": "PALACE",
  "webDir": "www",
  "backgroundColor": "#09080f",
  "android": {
    "backgroundColor": "#09080f",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#09080f",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#09080f"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "updateUrl": "",
      "appReadyTimeout": 10000,
      "version": "0.1.0"
    }
  }
}
